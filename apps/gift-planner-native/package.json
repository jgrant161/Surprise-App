{
  "name": "surprise-stash-native",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor shell that wraps the hosted Surprise Stash gift planner web app for the App Store and Google Play.",
  "scripts": {
    "sync": "cap sync",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "assets": "capacitor-assets generate --iconBackgroundColor '#db2777' --iconBackgroundColorDark '#db2777' --splashBackgroundColor '#db2777' --splashBackgroundColorDark '#db2777'",
    "resources": "node scripts/make-resources.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
